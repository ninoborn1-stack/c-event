{
  "name": "c-event",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @c-event/web dev",
    "build": "pnpm --filter @c-event/web build",
    "start": "pnpm --filter @c-event/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @c-event/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docs:placeholders": "pnpm --filter @c-event/content docs:placeholders",
    "build:pages": "pnpm --filter @c-event/web build:pages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
