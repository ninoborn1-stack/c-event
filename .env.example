# Zentraler Schalter: demo = alles lokal (Mails im Cockpit-Postfach, JSON-Ablage), live = echte Services
DATA_MODE=demo

# Öffentliche Basis-URL (Canonical, Sitemap, OpenGraph). Im Januar ggf. auf die Domain für den neuen Namen umstellen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo-Ablage (optional, Standard: apps/web/.demo-data)
DEMO_DATA_DIR=

# --- Live (später) ---
# Mailversand (z. B. Postmark, Resend oder SMTP)
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
# Empfänger der Anfragen (Celia)
INQUIRY_RECIPIENT=
# Kalender-Quelle (z. B. öffentliche iCal-URL nur mit Frei/Belegt)
AVAILABILITY_ICAL_URL=

# Social Feed: Instagram API with Instagram Login (Business-/Creator-Account), langlebiges Token (60 Tage),
# regelmäßig mit refreshInstagramToken() verlängern – siehe docs/UEBERGABE.md
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_HANDLE=cneventagency

# Google-Rezensionen – Variante A: Places API (max. 5, Inhalte nicht speichern, nur Place-ID)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Variante B: Business Profile API (alle Rezensionen, OAuth des verifizierten Inhabers)
GOOGLE_BP_CLIENT_ID=
GOOGLE_BP_CLIENT_SECRET=
GOOGLE_BP_REFRESH_TOKEN=
GOOGLE_BP_ACCOUNT_ID=
GOOGLE_BP_LOCATION_ID=

# Admin-Login (live): Anbieter-Konfiguration, z. B. Auth.js
AUTH_SECRET=
